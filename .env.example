# Copy to .env (git-ignored) or export in your shell / CI. Values intentionally left empty.

# Firebase App Check debug token for dev builds (register it in Firebase console > App Check > Apps > Manage debug tokens)
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Google Maps (Android-restricted key). Used by the map tiles and the Routes API.
GOOGLE_MAPS_ANDROID_API_KEY=
# SHA-1 of the signing certificate the key is restricted to, no colons, uppercase
ANDROID_CERT_SHA1=

# Optional: override the default ./google-services.json / ./GoogleService-Info.plist locations
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# Android release signing (absolute path to the keystore)
DELIVEROO_KEYSTORE_PATH=
DELIVEROO_KEYSTORE_PASSWORD=
DELIVEROO_KEY_ALIAS=
DELIVEROO_KEY_PASSWORD=
